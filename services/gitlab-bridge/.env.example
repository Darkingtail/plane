# ============================================================================
# Plane GitLab Bridge - 环境变量配置
# ============================================================================
# 使用方法:
#   1. cp .env.example .env
#   2. 修改配置值
#   3. docker compose up -d
# ============================================================================

# Plane Configuration (Required)
PLANE_BASE_URL=http://plane-api:8000
PLANE_API_KEY=plane_api_your-api-key-here
PLANE_WORKSPACE_SLUG=your-workspace-slug
PLANE_WEBHOOK_SECRET=your-webhook-secret
PLANE_PROJECT_ID=your-project-uuid

# Plane State Names (match your project's state names)
STATE_DEVELOPING=In Progress
STATE_INTEGRATING=Integrating
STATE_TESTING=Testing
STATE_TO_PUBLISH=To Publish
STATE_DONE=Done

# GitLab Configuration (Required)
GITLAB_URL=http://your-gitlab-server.com
GITLAB_TOKEN=your-gitlab-personal-access-token

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_ENABLED=true

# API Configuration
API_TIMEOUT=30
MAX_RETRIES=3
